# Local settings of the Supabase CLI stack (`npx supabase start`), copied to
# `supabase/.env` (git-ignored). The CLI reads that file and passes the values to
# the Edge Functions (see [edge_runtime.secrets] in config.toml).
#
# Create it with:
#   printf 'FAKE_PAYMENT_WEBHOOK_SECRET=%s\nFAKE_PAYMENTS_ENABLED=true\n' "$(openssl rand -hex 32)" > supabase/.env
#
# The payment provider's signing secret. The functions refuse to work without it.
FAKE_PAYMENT_WEBHOOK_SECRET=
#
# The demo's fake card step lets the app itself report that a card was approved, so the
# payment functions refuse to work unless this says exactly `true`. Local and demo: true.
# A server that takes real payments leaves it out.
FAKE_PAYMENTS_ENABLED=true
