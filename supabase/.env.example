# Local settings of the Supabase CLI stack (`npx supabase start`), copied to
# `supabase/.env` (git-ignored). The CLI reads that file and passes the values to
# the Edge Functions (see [edge_runtime.secrets] in config.toml).
#
# Create it with:
#   echo "FAKE_PAYMENT_WEBHOOK_SECRET=$(openssl rand -hex 32)" > supabase/.env
#
# The payment provider's signing secret. The functions refuse to work without it.
FAKE_PAYMENT_WEBHOOK_SECRET=
