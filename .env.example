# Copy to `.env` (git-ignored) and fill in. Nothing in this file is a real value.
# Variables are introduced step by step; "(step x)" tells you when each is first used.
#
# PUBLIC values (safe in the web build / APK) live in config/<env>.json, not here.
# Everything below is SECRET and must never end up in the app, the web build or git.

# Supabase secret key (sb_secret_..., formerly "service role"): bypasses RLS.
# Used by the payment webhook handler and by seeding scripts only. The
# publishable key (sb_publishable_...) is the public one and goes in config/*.json. (step b)
SUPABASE_SECRET_KEY=

# Postgres password of the Supabase project / self-hosted stack. Letters and digits only. (step b)
POSTGRES_PASSWORD=

# HMAC secret the fake payment provider signs webhook events with.
# Lives in the Edge Function environment only. (step f)
FAKE_PAYMENT_WEBHOOK_SECRET=

# Cloudflare API token + account id for deploying to Pages. Store them as
# GitHub Actions secrets, not in a file. (step h)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
