# Template of the SECRET values the scripts in this repository read. Copy to `.env`
# (git-ignored) and fill in; nothing in this file is a real value.
#
# The scripts read plain environment variables and do not load `.env` themselves:
#   set -a; . ./.env; set +a
# or `export` the few you need for one command and `unset` them afterwards.
#
# PUBLIC values (safe in the web build and the APK) live in config/<env>.json, not
# here. The full list of every variable, who reads it and where to get it is in
# docs/env-vars.md.

# --- Hosted Supabase project (deploy/demo/setup-supabase.sh) ---------------------

# Account token (dashboard > Account > Access Tokens).
SUPABASE_ACCESS_TOKEN=
# The project's reference: the part of its address before .supabase.co (not secret).
SUPABASE_PROJECT_REF=
# The database password chosen when the project was created.
SUPABASE_DB_PASSWORD=

# Secret key (sb_secret_..., formerly "service role"): bypasses row level security.
# Needed only for a few minutes, to create staff accounts (tool/create_staff_user.py).
# Never in the app, the web build or git.
SUPABASE_SECRET_KEY=

# --- Payment provider -------------------------------------------------------------

# The secret the (fake) payment provider signs webhook events with: at least 32
# characters, e.g. `openssl rand -hex 32`. It lives in the Edge Function
# environment; keep a copy, the payment smoke test needs the same value. For a real
# provider this is replaced by that provider's webhook secret.
FAKE_PAYMENT_WEBHOOK_SECRET=

# --- Cloudflare (deploy/demo/deploy-web.sh, or `npx wrangler login` instead) ------

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Staff accounts (tool/create_staff_user.py) ------------------------------------

# A strong, unique password for a real staff account. (Locally the script has
# throw-away defaults for the development stack.)
STAFF_EMAIL=
STAFF_PASSWORD=
