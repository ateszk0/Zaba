# Settings of the self-hosted staging environment. Copy to `zaba-selfhost.env`
# (git-ignored) and edit. The installer reads this file.
#
# Secrets (database password, JWT secret, API keys, ...) are NOT here: the
# installer generates them into the stack's own `.env` on the server.

# The three public host names, all served through the same Cloudflare Tunnel.
# They must be under a domain that is on Cloudflare.
ZABA_APP_HOST=app-staging.example.com
ZABA_API_HOST=api-staging.example.com
ZABA_ADMIN_HOST=admin-staging.example.com

# https behind the tunnel. Only for a test on your own machine use http.
ZABA_PUBLIC_SCHEME=https

# Where the stack is installed on the server.
ZABA_STACK_DIR=$HOME/zaba-stack

# Cloudflare Tunnel token (SECRET). Leave empty until the tunnel exists, then
# fill it in and run `./install.sh` again.
CLOUDFLARE_TUNNEL_TOKEN=

# The official Supabase self-hosting release this setup is pinned to. Changing
# it is an upgrade: read the CHANGELOG of that release first.
SUPABASE_SELFHOST_REF=self-hosted/v0.8.3

# Direct access to the web server without the tunnel (for example from a phone
# on the same Wi-Fi). 127.0.0.1 = this machine only; 0.0.0.0 = the whole LAN.
ZABA_HTTP_BIND=127.0.0.1
ZABA_HTTP_PORT=8080
